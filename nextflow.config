manifest {
    name = 'pseudogenes-nextflow'
    author = 'Pedro'
    homePage = 'local'
    description = 'Nextflow DSL2 pipeline for pseudogene discovery'
    version = '0.1.0'
}

params {
    outdir = 'results_nf'
    

    uniprot_fasta = 'uniprot_sprot.fasta'
    genome_fasta = 'genoma/GCF_000005845.2_ASM584v2_genomic.fna'
    genome_gff = 'genoma/GCF_000005845.2_ASM584v2_genomic.gff'

    uniprot_url = 'https://ftp.ebi.ac.uk/pub/databases/uniprot/current_release/knowledgebase/complete/uniprot_sprot.fasta.gz'
    genome_gff_url = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/005/845/GCF_000005845.2_ASM584v2/GCF_000005845.2_ASM584v2_genomic.gff.gz'
    genome_url = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/005/845/GCF_000005845.2_ASM584v2/GCF_000005845.2_ASM584v2_genomic.fna.gz'
    blast_url = 'https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/LATEST/ncbi-blast-2.17.0+-x64-linux.tar.gz'
    fasta_url = 'https://fasta.bioch.virginia.edu/wrpearson/fasta/executables/fasta-36.3.8i-linux64.tar.gz'
    
    blast_bin_dir = "${projectDir}/ncbi-blast-2.17.0+/bin"
    fasta_bin_dir = "${projectDir}/fasta-36.3.8i/bin"
    genomes_dir = "conda_dataset/my-genomes/ncbi_dataset/data/"
    ssearch_bin = "${projectDir}/fasta-36.3.8i/bin/ssearch36"

    shuffle_count = 10000
    ssearch_chunk_size = 200

    blast_word_size = 3
    blast_gapopen = 11
    blast_gapextend = 1
    blast_matrix = 'BLOSUM62'
    blast_threshold = 13
    blast_comp_stats = 2
    blast_evalue_null = 10
    blast_evalue_tblastn = 1
    blast_max_target_seqs = 10000

    // Threshold source control:
    // 1) min_evalue_file, 2) min_evalue_manual, 3) run_null_model (default)
    run_null_model = false
    min_evalue_file = null
    min_evalue_manual = null
    
    ssearch_k = 500
    ssearch_f = -11
    ssearch_g = -1
    ssearch_matrix = 'BL62'
    ssearch_z = 11
    ssearch_Z = 10000

    min_coverage = 0.8
    final_min_identity = 0
}

process {
    withLabel: heavy {
        cpus = 4
        memory = '4 GB'
        time = '24h'
    }

    withLabel: medium {
        cpus = 2
        memory = '2 GB'
        time = '8h'
    }

    withLabel: light {
        cpus = 1
        memory = '1 GB'
        time = '1h'
    }
}

profiles {
    local {
        process.executor = 'local'
    }

    hpc {
        process.executor = 'slurm'
        process.queue = 'batch'
    }

    docker {
        docker.enabled = true
    }

    singularity {
        singularity.enabled = true
    }
}
